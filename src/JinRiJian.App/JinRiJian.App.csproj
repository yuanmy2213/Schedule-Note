<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>JinRiJian</AssemblyName>
    <RootNamespace>JinRiJian.App</RootNamespace>
    <StartupObject>JinRiJian.App.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../JinRiJian.Core/JinRiJian.Core.csproj"/><EmbeddedResource Include="Assets/app.ico"/></ItemGroup>
</Project>
